# Supabase project API settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only secrets. NEVER prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY
# Generate with: openssl rand -base64 32
COUNSELLOR_NOTES_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# Public deployed URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional social login buttons. Providers must also be enabled in Supabase Auth.
NEXT_PUBLIC_ENABLE_GOOGLE=false
NEXT_PUBLIC_ENABLE_MICROSOFT=false
